+        self._dbt_buf: torch.Tensor | None = None
         self._reserve_workspace()
 
+    def _expand_decode_rows(
+        self, cam: CommonAttentionMetadata, num_decodes: int, num_decode_tokens: int
+    ) -> tuple[torch.Tensor, torch.Tensor]:
+        """Per-token decode rows for the first num_decodes requests.
+
+        Row t of request r (local position j, 0-based) gets
+        seq_len = seq_lens[r] - query_len[r] + j + 1 and request r's block table.
+        Written into persistent buffers so a captured decode graph reads the
+        current step's values at replay.
+        """
+        n = num_decode_tokens
+        dev = cam.query_start_loc.device
+        bt = cam.block_table_tensor
+        max_reqs = self.vllm_config.scheduler_config.max_num_seqs
+        rows = max_reqs * max(1, self.reorder_batch_threshold or 1)
+        if (
+            self._dsl_buf is None
+            or self._dsl_buf.shape[0] < n
+            or self._dbt_buf.shape[1] != bt.shape[1]
+        ):
+            rows = max(rows, n)
+            self._dsl_buf = torch.zeros(rows, dtype=torch.int32, device=dev)
+            self._dbt_buf = torch.zeros(
+                (rows, bt.shape[1]), dtype=bt.dtype, device=dev
+            )
+        if cam.max_query_len == 1:
+            # plain decode: the rows are the requests
+            self._dsl_buf[:n].copy_(cam.seq_lens[:num_decodes])
+            self._dbt_buf[:n].copy_(bt[:num_decodes])
+            return self._dsl_buf[:n], self._dbt_buf[:n]
+        qsl = cam.query_start_loc[: num_decodes + 1]
+        q_lens = qsl[1:] - qsl[:-1]
+        req_idx = torch.repeat_interleave(
+            torch.arange(num_decodes, device=dev), q_lens, output_size=n
+        )
+        local = torch.arange(n, device=dev, dtype=torch.int32) - qsl[req_idx]
+        self._dsl_buf[:n].copy_(
+            cam.seq_lens[:num_decodes][req_idx] - q_lens[req_idx] + local + 1
+        )
+        torch.index_select(bt[:num_decodes], 0, req_idx, out=self._dbt_buf[:n])
+        return self._dsl_buf[:n], self._dbt_buf[:n]
+
